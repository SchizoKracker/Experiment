; Engine configuration file.
config_version=5

[application]

config/name="Gutterlight"
config/description="A turn-based tactical RPG of candlefolk beneath a dying sun."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.03, 0.02, 1)
boot_splash/show_image=false

[autoload]

Events="*res://src/autoload/events.gd"
Data="*res://src/autoload/data_registry.gd"
GameState="*res://src/autoload/game_state.gd"
Audio="*res://src/autoload/audio_director.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.012, 0.01, 1)
lights_and_shadows/positional_shadow/atlas_size=2048
